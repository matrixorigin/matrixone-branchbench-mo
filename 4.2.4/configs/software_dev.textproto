# Software Development workflow — MatrixOne, FULL scale (Table 1).
run_id: "macro_software_dev_full_mo"
backend: MATRIXONE
workflow: SOFTWARE_DEV

database_setup {
    db_name: "macro_softdev_full_mo"
    cleanup: true
}

setup {
    workers: 5              # T
    total_steps: 20         # S
    root_fanout: 5          # F_r
    inner_fanout: 3         # F_i
    max_depth: 4            # D
    cross_branch_queries: 1 # C
    db_scale: 0
}

step {
    schema_changes: 2   # M_s — SoftwareDevOps.mutate_ddl emits 2 ALTERs
                        # (loyalty_tier + credit_lim); the DML/eval need both.
                        # Repo's full config ships M_s=1, which leaves credit_lim
                        # uncreated and breaks every DML/eval on any backend.
    data_mutations: 1   # M_d
    eval_queries: 2     # Q_v
    prune_prob: 0.1     # gamma
}

autocommit: true

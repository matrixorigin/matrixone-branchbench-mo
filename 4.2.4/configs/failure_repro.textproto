# Failure Reproduction workflow — MatrixOne, FULL scale (Table 1).
run_id: "macro_failure_repro_full_mo"
backend: MATRIXONE
workflow: FAILURE_REPRO

database_setup {
    db_name: "macro_failrepro_full_mo"
    cleanup: true
}

setup {
    workers: 1              # T
    total_steps: 10         # S
    root_fanout: 10         # F_r
    max_depth: 1            # D
    cross_branch_queries: 0 # C
    db_scale: 1
}

step {
    schema_changes: 5   # M_s
    data_mutations: 45  # M_d
    eval_queries: 1     # Q_v
    prune_prob: 1.0     # gamma
}

autocommit: true

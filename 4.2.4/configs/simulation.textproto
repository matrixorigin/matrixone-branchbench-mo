# MC Simulation workflow — MatrixOne, FULL scale (Table 1, Section 3.3).
# T=1000 workers, F_r=1000 flat star. Stress test: up to ~1000 concurrent
# physical branch clones on the shared free-tier. Paper's 2h timeout applies.
run_id: "macro_simulation_full_mo"
backend: MATRIXONE
workflow: SIMULATION

database_setup {
    db_name: "macro_simfull_mo"
    cleanup: true
}

setup {
    workers: 1000           # T
    total_steps: 1          # S
    root_fanout: 1000       # F_r
    max_depth: 1            # D (flat star)
    cross_branch_queries: 1 # C
    db_scale: 0
}

step {
    schema_changes: 0   # M_s
    data_mutations: 50  # M_d
    eval_queries: 1     # Q_v
    prune_prob: 1.0     # gamma
}

autocommit: true

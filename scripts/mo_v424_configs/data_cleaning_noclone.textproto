# Data Cleaning workflow — MatrixOne, FULL scale (Table 1).
# gamma=0.0 (no pruning): ~200 live branches accumulate.
run_id: "macro_data_cleaning_full_mo"
backend: MATRIXONE
workflow: DATA_CLEANING

database_setup {
    db_name: "macro_dataclean_full_mo"
    cleanup: true
}

setup {
    workers: 10             # T
    total_steps: 20         # S
    root_fanout: 10         # F_r
    inner_fanout: 3         # F_i
    max_depth: 3            # D
    cross_branch_queries: 2 # C
    db_scale: 0
}

step {
    schema_changes: 1   # M_s
    data_mutations: 1   # M_d
    eval_queries: 1     # Q_v
    prune_prob: 0.0     # gamma
}

autocommit: true

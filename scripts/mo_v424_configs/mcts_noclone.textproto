# MCTS workflow — MatrixOne, FULL scale (Table 1).
# 10 workers x 100 steps, gamma=0.1: ~900 live branches accumulate (deep tree D=25).
run_id: "macro_mcts_full_mo"
backend: MATRIXONE
workflow: MCTS

database_setup {
    db_name: "macro_mcts_full_mo"
    cleanup: true
}

setup {
    workers: 10             # T
    total_steps: 100        # S
    root_fanout: 10         # F_r
    inner_fanout: 10        # F_i
    max_depth: 25           # D
    cross_branch_queries: 0 # C
    db_scale: 1
}

step {
    schema_changes: 0   # M_s
    data_mutations: 1   # M_d
    eval_queries: 1     # Q_v
    prune_prob: 0.1     # gamma
}

autocommit: true
